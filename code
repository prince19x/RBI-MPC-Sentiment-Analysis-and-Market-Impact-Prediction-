import pandas as pd
import numpy as np

def calculate_daily_sentiment():
    print("Loading sentence-level dataset...")
    # Load your final dataset from Phase 3
    df = pd.read_csv("rbi_final_analyzed_dataset.csv")

    # Create binary columns to easily count the sentiments
    df['is_dovish'] = (df['sentiment'] == 'Dovish').astype(int)
    df['is_hawkish'] = (df['sentiment'] == 'Hawkish').astype(int)
    df['is_neutral'] = (df['sentiment'] == 'Neutral').astype(int)

    print("Aggregating scores by Date and Topic...")
    # Group the data by both the meeting 'date' and the 'topic_name'
    daily_topic_sentiment = df.groupby(['date', 'topic_name']).agg(
        total_sentences=('text', 'count'),
        dovish_count=('is_dovish', 'sum'),
        hawkish_count=('is_hawkish', 'sum'),
        neutral_count=('is_neutral', 'sum')
    ).reset_index()

    print("Calculating Sentiment Balance...")
    # Calculate the Sentiment Balance as defined in the paper:
    # (Dovish - Hawkish) / (Dovish + Hawkish)

    # We calculate the denominator first
    denominator = daily_topic_sentiment['dovish_count'] + daily_topic_sentiment['hawkish_count']

    # We use np.where to avoid division by zero errors
    # (e.g., if a topic only had 'Neutral' sentences that day)
    daily_topic_sentiment['sentiment_balance'] = np.where(
        denominator > 0,
        (daily_topic_sentiment['dovish_count'] - daily_topic_sentiment['hawkish_count']) / denominator,
        0  # Default to 0 if the denominator is 0
    )

    # Save the final time-series dataset!
    output_filename = "rbi_daily_sentiment_for_regression.csv"
    daily_topic_sentiment.to_csv(output_filename, index=False)

    print(f"\nAggregation complete! Saved to '{output_filename}'")

    # Display a preview of the structured data
    print("\nPreview of your Regression-Ready Data:")
    print(daily_topic_sentiment[['date', 'topic_name', 'sentiment_balance']].head(10))

if __name__ == "__main__":
    calculate_daily_sentiment()

