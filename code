def fetch_content(url):
    """Fetches HTML content from the RBI website."""
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
    }
    try:
        response = requests.get(url, headers=headers, timeout=15)
        response.raise_for_status()
        return response.text
    except Exception as e:
        print(f"Error fetching {url}: {e}")
        return None

def clean_text(text):
    """
    Cleans text by removing footnote markers, consolidating whitespace,
    and standardizing line breaks as specified in the paper.
    """
    if not text:
        return ""
    # Remove footnote markers like [1], [2], or asterisks
    text = re.sub(r'\[\d+\]', '', text)
    text = re.sub(r'\*', '', text)
    # Consolidate whitespace and standardize line breaks
    text = re.sub(r'\s+', ' ', text)
    return text.strip()

def filter_sentences(text, min_words=3):
    """
    Tokenizes text into sentences and filters out irrelevant ones
    (e.g., less than 3 words) as outlined in Appendix A of the paper.
    """
    sentences = sent_tokenize(text)
    valid_sentences = []
    for sent in sentences:
        if len(sent.split()) >= min_words:
            valid_sentences.append(sent)
    return " ".join(valid_sentences)

def process_mps(html_content, metadata):
    """
    Extracts and structures Monetary Policy Statements (MPS).
    Divides the text into individual paragraphs.
    """
    soup = BeautifulSoup(html_content, 'html.parser')
    paragraphs = soup.find_all('p')

    structured_data = []
    for i, p in enumerate(paragraphs):
        raw_text = p.get_text()
        cleaned_text = clean_text(raw_text)
        filtered_text = filter_sentences(cleaned_text)

        if filtered_text:
            row = metadata.copy()
            row['paragraph_id'] = f"{metadata['date']}_p{i}"
            row['speaker'] = "RBI MPC" # Official statement
            row['text'] = filtered_text
            structured_data.append(row)

    return structured_data

def process_qna(html_content, metadata):
    """
    Extracts and structures Post-Monetary Policy Press Conference Q&As.
    Separates text into distinct question-answer pairs and isolates
    answers from the Governor and Deputy Governors.
    """
    soup = BeautifulSoup(html_content, 'html.parser')
    paragraphs = soup.find_all(['p', 'div'])

    structured_data = []
    current_speaker = None

    # Target titles to extract (Governors and Deputy Governors)
    target_speakers = ['governor', 'deputy governor', 'shaktikanta das', 'michael', 'patra', 'rajan', 'urjit', 'patel']

    for i, p in enumerate(paragraphs):
        raw_text = p.get_text()
        cleaned_text = clean_text(raw_text)

        # Detect Speaker change (Usually formatted as "Speaker Name: Text")
        speaker_match = re.match(r"^([A-Za-z\s\.\,]+):", cleaned_text)
        if speaker_match:
            current_speaker = speaker_match.group(1).strip()
            # Remove the speaker name from the actual text
            cleaned_text = cleaned_text[len(speaker_match.group(0)):].strip().lower()

        filtered_text = filter_sentences(cleaned_text)

        # Only save the text if we have a valid speaker and the speaker is a Governor/DG
        if filtered_text and current_speaker:
            is_target = any(target.lower() in current_speaker.lower() for target in target_speakers)
            if is_target:
                row = metadata.copy()
                row['paragraph_id'] = f"{metadata['date']}_qna_{i}"
                row['speaker'] = current_speaker
                row['text'] = filtered_text
                structured_data.append(row)

    return structured_data

