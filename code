import pandas as pd
import numpy as np
import yfinance as yf
import statsmodels.api as sm
import matplotlib.pyplot as plt

def run_local_projections():
    print("1. Loading Sentiment Data...")
    sentiment_df = pd.read_csv("rbi_daily_sentiment_for_regression.csv")
    sentiment_df['date'] = pd.to_datetime(sentiment_df['date'])

    # Pivot so each topic has its own column
    regression_df = sentiment_df.pivot(index='date', columns='topic_name', values='sentiment_balance').fillna(0)
    regression_df.columns = [col.replace(' ', '_').replace('-', '_') for col in regression_df.columns]
    regression_df = regression_df.reset_index()

    # --- Create Dummy Variables ---
    print("2. Constructing Dummies (COVID, GST, Governors)...")
    regression_df['COVID'] = ((regression_df['date'] >= '2020-03-11') & (regression_df['date'] <= '2021-12-31')).astype(int)
    regression_df['GST'] = (regression_df['date'] >= '2017-07-01').astype(int)
    regression_df['Rajan'] = (regression_df['date'] <= '2016-09-04').astype(int)
    regression_df['Patel'] = ((regression_df['date'] >= '2016-09-05') & (regression_df['date'] <= '2018-12-11')).astype(int)

    print("3. Downloading BSE Sensex Market Data...")
    start_date = (regression_df['date'].min() - pd.Timedelta(days=10)).strftime('%Y-%m-%d')
    end_date = (regression_df['date'].max() + pd.Timedelta(days=60)).strftime('%Y-%m-%d')

    sensex = yf.download('^BSESN', start=start_date, end=end_date, progress=False)

    # --- THE FIX: Flatten yfinance MultiIndex columns ---
    if isinstance(sensex.columns, pd.MultiIndex):
        sensex.columns = sensex.columns.get_level_values(0)
    # ---------------------------------------------------

    sensex = sensex.reset_index()
    sensex['Date'] = pd.to_datetime(sensex['Date']).dt.tz_localize(None)

    sensex_close = sensex['Close'].squeeze()
    sensex_open = sensex['Open'].squeeze()

    print("4. Calculating Cumulative Forward Returns (h=0 to 30)...")
    for h in range(31):
        future_close = sensex_close.shift(-h)
        sensex[f'Return_h{h}'] = np.log(future_close / sensex_open) * 10000

    print("5. Merging Data...")
    final_df = pd.merge(regression_df, sensex, left_on='date', right_on='Date', how='inner')

    # Pick the topic to test
    target_topic = 'Inflation_Dynamics_and_Price_Stability'
    if target_topic not in final_df.columns:
        target_topic = [c for c in regression_df.columns if c not in ['date', 'COVID', 'GST', 'Rajan', 'Patel']][0]

    print(f"\n--- Running Local Projections for Topic: {target_topic} ---")

    horizons = list(range(31))
    betas = []
    ci_lower = []
    ci_upper = []

    for h in horizons:
        temp_df = final_df.dropna(subset=[f'Return_h{h}'])
        Y = temp_df[f'Return_h{h}']
        X = temp_df[[target_topic, 'COVID', 'GST', 'Rajan', 'Patel']]
        X_sm = sm.add_constant(X)

        # Fit OLS with HAC (Newey-West) standard errors
        model = sm.OLS(Y, X_sm).fit(cov_type='HAC', cov_kwds={'maxlags': h + 1})

        beta = model.params[target_topic]
        conf_int = model.conf_int(alpha=0.10)

        betas.append(beta)
        ci_lower.append(conf_int.loc[target_topic, 0])
        ci_upper.append(conf_int.loc[target_topic, 1])

    print("6. Plotting the Impulse Response Function (IRF)...")
    plt.figure(figsize=(10, 6))
    plt.axhline(0, color='red', linestyle='-', linewidth=1)
    plt.plot(horizons, betas, color='#1f77b4', linewidth=2, label=f'Response to {target_topic.replace("_", " ")}')
    plt.fill_between(horizons, ci_lower, ci_upper, color='#1f77b4', alpha=0.2, label='90% CI')

    plt.title(f"Dynamic Response of BSE Sensex to '{target_topic.replace('_', ' ')}'\n(Local Projections over 30 Days)", fontsize=14, pad=15)
    plt.xlabel("Days from MPC Press Conference", fontsize=12)
    plt.ylabel("Response (Basis Points)", fontsize=12)
    plt.xlim(0, 30)
    plt.legend(loc='upper left')
    plt.grid(True, linestyle='--', alpha=0.5)
    plt.tight_layout()

    plt.savefig("impulse_response_function.png", dpi=300)
    plt.show()

    print("\nProject Analysis Complete! Check your folder for 'impulse_response_function.png'.")

if __name__ == "__main__":

    run_local_projections()



