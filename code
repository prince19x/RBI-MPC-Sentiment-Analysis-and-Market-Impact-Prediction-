import pandas as pd
from sentence_transformers import SentenceTransformer
from umap import UMAP
from hdbscan import HDBSCAN
from sklearn.feature_extraction.text import CountVectorizer
from bertopic import BERTopic

def main():
    print("Loading the dataset...")
    # 1. Load the data from Phase 1
    df = pd.read_csv("rbi_monetary_policy_corpus.csv")

    # Drop any empty rows just in case, and ensure everything is a string
    df = df.dropna(subset=['text'])
    docs = df['text'].astype(str).tolist()
    print(f"Loaded {len(docs)} sentences for modeling.")

    # 2. Generate Embeddings
    # The paper explicitly uses the "all-MiniLM-L6-v2" model because it is
    # highly efficient and performs well on semantic similarity tasks.
    print("Generating sentence embeddings (this might take a few minutes)...")
    embedding_model = SentenceTransformer("all-MiniLM-L6-v2")
    embeddings = embedding_model.encode(docs, show_progress_bar=True)

    # 3. Dimensionality Reduction (UMAP)
    # The paper sets n_neighbors=15 and n_components=5 to balance local
    # structure preservation with global dimensionality reduction.
    print("Setting up UMAP for dimensionality reduction...")
    umap_model = UMAP(
        n_neighbors=15,
        n_components=5,
        min_dist=0.0,
        metric='cosine',
        random_state=42 # Set random_state for reproducibility
    )

    # 4. Clustering (HDBSCAN)
    # The paper uses min_cluster_size=50 to ensure topics have substantial
    # support in the data and to minimize spurious/junk topics.
    print("Setting up HDBSCAN for clustering...")
    hdbscan_model = HDBSCAN(
        min_cluster_size=50,
        min_samples=12,
        metric='euclidean',
        cluster_selection_method='eom',
        prediction_data=True
    )

    # 5. Topic Representation (CountVectorizer for c-TF-IDF)
    # We remove standard English stop words so the model focuses on financial terms
    vectorizer_model = CountVectorizer(stop_words="english")

    # 6. Initialize and Train BERTopic
    print("Training the BERTopic model...")
    topic_model = BERTopic(
        embedding_model=embedding_model,
        umap_model=umap_model,
        hdbscan_model=hdbscan_model,
        vectorizer_model=vectorizer_model,
        calculate_probabilities=False # Set to True if you want soft-clustering, but False is faster
    )

    # Fit the model and extract topics
    topics, probs = topic_model.fit_transform(docs, embeddings)

    # 7. Review and Save Results
    # Attach the assigned topic numbers back to our original dataframe
    df['topic_id'] = topics

    # Save the updated dataframe
    df.to_csv("rbi_corpus_with_topics.csv", index=False)

    # Save the BERTopic model so you don't have to retrain it later!
    topic_model.save("rbi_bertopic_model_dir", serialization="safetensors", save_ctfidf=True)

    print("\nModel Training Complete!")
    print("\n--- Top Identified Topics ---")
    # This prints a dataframe showing the Topic ID, Count of sentences, and the top words
    print(topic_model.get_topic_info().head(10))

if __name__ == "__main__":
    main()


