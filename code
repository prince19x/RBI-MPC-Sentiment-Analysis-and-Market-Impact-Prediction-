    end_date = (regression_df['date'].max() + pd.Timedelta(days=60)).strftime('%Y-%m-%d')

    sensex = yf.download('^BSESN', start=start_date, end=end_date, progress=False)

    # Flatten yfinance MultiIndex columns if necessary
    if isinstance(sensex.columns, pd.MultiIndex):
        sensex.columns = sensex.columns.get_level_values(0)

    sensex = sensex.reset_index()
    sensex['Date'] = pd.to_datetime(sensex['Date']).dt.tz_localize(None)

    sensex_close = sensex['Close'].squeeze()
    sensex_open = sensex['Open'].squeeze()

    print("4. Calculating Cumulative Forward Returns (h=0 to 30)...")
    for h in range(31):
        future_close = sensex_close.shift(-h)
        sensex[f'Return_h{h}'] = np.log(future_close / sensex_open) * 10000

    print("5. Merging Data...")
    final_df = pd.merge(regression_df, sensex, left_on='date', right_on='Date', how='inner')

    # Extract all the topic names dynamically (ignoring the date and dummy columns)
    topics_to_test = [c for c in regression_df.columns if c not in ['date', 'COVID', 'GST', 'Rajan', 'Patel']]

    print(f"\nFound {len(topics_to_test)} topics to analyze. Starting regressions...")

    # List to store all regression results
    all_results = []

    # --- THE LOOP: Run LP for every single topic ---
    for target_topic in topics_to_test:
        print(f"  -> Processing: {target_topic.replace('_', ' ')}")

        horizons = list(range(31))
        betas = []
        ci_lower = []
        ci_upper = []

        for h in horizons:
            temp_df = final_df.dropna(subset=[f'Return_h{h}'])
            Y = temp_df[f'Return_h{h}']
            X = temp_df[[target_topic, 'COVID', 'GST', 'Rajan', 'Patel']]
            X_sm = sm.add_constant(X)

            # Fit OLS with HAC (Newey-West) standard errors
            model = sm.OLS(Y, X_sm).fit(cov_type='HAC', cov_kwds={'maxlags': h + 1})

            beta = model.params[target_topic]
            conf_int = model.conf_int(alpha=0.10)

            betas.append(beta)
            ci_lower.append(conf_int.loc[target_topic, 0])
            ci_upper.append(conf_int.loc[target_topic, 1])

            all_results.append({
                'topic': target_topic.replace('_', ' '),
                'horizon': h,
                'beta': beta,
                'ci_lower': ci_lower[-1],
                'ci_upper': ci_upper[-1]
            })

        # --- Plotting individual graphs ---
        plt.figure(figsize=(10, 6))
        plt.axhline(0, color='red', linestyle='-', linewidth=1)
        plt.plot(horizons, betas, color='#1f77b4', linewidth=2, label=f'Response to {target_topic.replace('_', ' ')}')
        plt.fill_between(horizons, ci_lower, ci_upper, color='#1f77b4', alpha=0.2, label='90% CI')

        plt.title(f"Dynamic Response of BSE Sensex to '{target_topic.replace('_', ' ')}'\n(Local Projections over 30 Days)", fontsize=14, pad=15)
        plt.xlabel("Days from MPC Press Conference", fontsize=12)
        plt.ylabel("Response (Basis Points)", fontsize=12)
        plt.xlim(0, 30)
        plt.legend(loc='upper left')
        plt.grid(True, linestyle='--', alpha=0.5)
        plt.tight_layout()

        # Save each plot with a unique filename
        filename = f"irf_{target_topic.lower()}.png"
        plt.savefig(filename, dpi=300)

        # Display the plot in the notebook
        plt.show()

        # CRITICAL: Close the plot memory so the next loop starts with a fresh canvas
        plt.close()

    print("\nProject Analysis Complete! All IRF graphs have been saved to your folder.")

    # Display summary table
    summary_table = pd.DataFrame(all_results)
    print("\n--- Summary Table of Regression Coefficients ---")
    display(summary_table)

